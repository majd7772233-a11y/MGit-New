<resources>

    <attr name="pager_title_strip_background" format="reference"/>
    <attr name="bt_branch_name_bg" format="reference"/>
    <attr name="bt_branch_name_text_color" format="reference"/>
    <attr name="mgit_drawer_text_color"  format="reference" />
    <attr name="mgit_drawer_background" format="reference" />
    <attr name="ic_file_fl" format="reference" />
    <attr name="ic_folder_fl" format="reference" />
    <attr name="ic_branch_l" format="reference" />
    <attr name="ic_tag_l" format="reference" />

    <!-- Application theme. -->
    <style name="AppTheme" parent="Theme.Sgit">
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Application theme. -->
    <style name="DarkAppTheme" parent="Theme.SgitDark">
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="items_with_same_width">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1.0</item>
    </style>

    <!-- ================= Typography ================= -->

    <style name="TextAppearance.MGit.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MGit.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.MGit.Meta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?android:attr/textColorTertiary</item>
    </style>

    <style name="TextAppearance.MGit.SectionHeader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/secondary_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ================= Widgets ================= -->

    <style name="Widget.MGit.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MGit.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MGit.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.MGit.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">4dp</item>
    </style>

</resources>
