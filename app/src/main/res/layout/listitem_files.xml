<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:minHeight="56dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:id="@+id/fileIcon"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="11dp"
        android:src="?ic_file_fl"
        android:padding="5dp"
        android:contentDescription="@string/default_text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/default_text"
        android:id="@+id/fileTitle"
        android:layout_alignTop="@+id/fileIcon"
        android:layout_alignBottom="@+id/fileIcon"
        android:layout_toEndOf="@+id/fileIcon"
        android:layout_alignParentEnd="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="@dimen/file_list_item_text_size"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="start|center"
        android:maxLines="1"
        android:ellipsize="middle"/>

</RelativeLayout>
