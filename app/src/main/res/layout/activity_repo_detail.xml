<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/activity_repo_detail_content" />

    <RelativeLayout
        android:id="@+id/right_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="16dp"
        android:background="?mgit_drawer_background" >

        <ListView
            android:id="@+id/repoOperationList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/light_outline"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/selectable_background_sgit"
            android:layoutAnimation="@anim/layout_animation_fall_down" >
        </ListView>
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>
